# arcana.test + local — локальная проверка; arcanadiary.com + acme — боевой режим
SITE_DOMAIN=arcanadiary.com
TLS_MODE=acme
# false — до запуска (пароль + noindex), true — после запуска
LAUNCHED=false
STAGE_USER=arcana
STAGE_PASSWORD=

# --- API, stage 4.2. Real values only in deploy/.env on the server, never in git ---
# Supabase → Connect → connection string, pooler in transaction mode (port 6543)
DATABASE_URL=
ANTHROPIC_API_KEY=
# only needed when READER_PROVIDER=openai or gemini (and for the model comparison in api/evals/);
# ANTHROPIC_API_KEY is still needed then: the question check always runs on Claude
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
# claude (default), openai, gemini, or fake (canned answers, no model calls); READER_MODEL must match it
READER_PROVIDER=claude
READER_MODEL=claude-haiku-5-5
# output_config.effort of the reader: low | medium | high | xhigh | max
READER_EFFORT=medium
GUARD_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-sonnet-5-5
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
# exactly true or false. true: Caddy accepts only Cloudflare's addresses and the API reads CF-Connecting-IP;
# only with the Cloudflare proxy on (api/README.md, "Перед включением TRUST_CLOUDFLARE=true")
TRUST_CLOUDFLARE=false
# model spend per UTC day; above it the reader answers with the card base
DAILY_BUDGET_USD=5
# spend on the question check per UTC day; above it only stop-phrases answer, other questions get 503
GUARD_BUDGET_USD=1
# --- stage 4.3: sign-in. Supabase → Project Settings → API → Project URL (public, not a secret), e.g.
# https://abcdefghijklmnop.supabase.co ; empty — sign-in is off and any Authorization: Bearer gets 401
SUPABASE_URL=
# --- stage 4.4b: the browser's sign-in. Supabase → Project Settings → API Keys → the public (anon / publishable)
# key; public, not a secret — NEVER the service_role / sb_secret_… key (the API drops a secret key and logs it).
# Empty — sign-in is off: no "Save to diary" button, the diary says sign-in opens soon
SUPABASE_ANON_KEY=
# true — show "Continue with Google" (after Google is set up in Supabase, api/README.md); empty (or anything else,
# logged) — e-mail link only
GOOGLE_SIGNIN=
