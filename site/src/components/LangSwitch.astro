---
// EN | ES (pairs from hreflang.csv through src/lib/routes.ts). The current language is not a link; neither is a
// language whose page is hidden (no page links to a hidden service page, decision 35).
import { t } from '../i18n';
import { switchPath } from '../lib/routes';
import { hiddenPaths } from '../lib/textPages';
import type { Lang } from '../lib/types';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const other = switchPath(path);
const otherHidden = hiddenPaths().has(other) || hiddenPaths().has(path);
const d = t(lang);
---
<nav class="lang-switch" aria-label={d.langLabel}>
  {lang === 'en' ? <span aria-current="true" lang="en">EN</span>
    : otherHidden ? <span lang="en">EN</span> : <a href={other} lang="en">EN</a>}
  <span aria-hidden="true">|</span>
  {lang === 'es' ? <span aria-current="true" lang="es">ES</span>
    : otherHidden ? <span lang="es">ES</span> : <a href={other} lang="es">ES</a>}
</nav>
