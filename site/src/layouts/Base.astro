---
// Every page: language, title, fonts (our own, /fonts: Cormorant Garamond 500/600, Manrope 400–700; @font-face in global.css), tokens, the
// header with the menu and the language switch, the footer. The stage is closed by Caddy (password, X-Robots-Tag).
// `noindex`: the diary and the account (spec 4.4b §5, §6) — never indexed, also after the launch.
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n';
import type { PageKey } from '../lib/routes';
import type { Lang } from '../lib/types';

interface Props {
  lang: Lang;
  title: string;
  path: string;
  current?: PageKey;
  noindex?: boolean;
}

const { lang, title, path, current, noindex = false } = Astro.props;
const d = t(lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    <noscript><style>@media (max-width: 899px) { .site-nav { display: block; } .menu-button { display: none; } }</style></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">{d.skipToContent}</a>
    <Header lang={lang} path={path} current={current} />
    <main id="main" class="container" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} path={path} />
  </body>
</html>
